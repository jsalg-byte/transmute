# Server-only. Set these in the new Coolify application's production environment.
# Copy the production DATABASE_URL value from the existing Coolify application.
# Never put this value in the Expo app or an EXPO_PUBLIC_* variable.
DATABASE_URL=postgresql://provided-by-coolify/transmute
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
PORT=3000
AUTH_ISSUER=transmute-api
# Comma-separated browser origins. Native clients do not rely on CORS.
CORS_ORIGINS=http://localhost:8081,https://your-transmute-web-domain.example
